      "path": "prototypes/zero-reference-planes-live",
      "note": "Kvadratens sida motsvarar cirkelns diameter."
    },
    {
      "title": "Linjer och alla tolv kombinationer",
      "commit": "0167f510df5c091e0879eabea7617ae278a2685e",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Fyra varianter med tre styrkor; Cirkel och Diskret är förval."
    },
    {
      "title": "Första jämförelsen av toning",
      "commit": "26ca4ee3cd1c57698cab0181dbc15a96e3672ab3",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Svag ton jämförs med innehåll framför planen; fasta tonvärden är provvärden."
    },
    {
      "title": "Stark ton och kamerakostnad",
      "commit": "4ba7e02f7d429a6047e81ca545ebdf0847621ee5",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Starkare ton, reglage och vektorbaserad toning; 60 procent är inte produktförval."
    },
    {
      "title": "Positionsdel i egenskaperna",
      "commit": "ffe2ff25fd2953e164017a6465b22af36d76c893",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Tre alternativ finns som underlag. Placeringen i egenskaperna är bortvald."
    },
    {
      "title": "Koordinater i navigeringsfönstret",
      "commit": "d80e5587afb713d1137b13bd94b731a986b61222",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Tre fält i rad ovanför objektflyttknapparna. Verkställningsknappen är bortvald."
    },
    {
      "title": "Direkt flytt vid giltigt värde",
      "commit": "120ffd87326b26c2b6a2505f8c79672b2e6a86c6",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Ingen verkställningsknapp; axlarna valideras oberoende."
    },
    {
      "title": "Två decimaler och infoikon",
      "commit": "7981112afab2cfdac72df639bc5a132926a31b82",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Avrundning, infoikon, ingen dubbel positionstext och ingen rotationsmening."
    },
    {
      "title": "Slutlig minivy i denna granskning",
      "commit": "ee7a31709c158deb774c483379aa96de7d72e482",
      "path": "prototypes/zero-reference-planes-live",
      "note": "Rubrik, infoikon och öppen hjälp döljs i miniläge; koordinaterna finns kvar."
    }
