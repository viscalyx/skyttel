{
  "name": "Skyttel development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/skyttel",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/skyttel,type=bind,consistency=cached",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "init": true,
  "mounts": [
    "source=skyttel-${devcontainerId}-data,target=/data,type=volume",
    "source=skyttel-${devcontainerId}-codex,target=/home/vscode/.codex,type=volume",
    "source=skyttel-${devcontainerId}-config,target=/home/vscode/.config,type=volume",
    "source=skyttel-${devcontainerId}-vscode,target=/home/vscode/.vscode-server,type=volume",
    "source=skyttel-${devcontainerId}-modules,target=/workspaces/skyttel/node_modules,type=volume",
    "source=skyttel-${devcontainerId}-worktrees,target=/home/vscode/worktrees,type=volume"
  ],
  "containerEnv": {
    "SKYTTEL_DATABASE_PATH": "/data/skyttel.sqlite",
    "HOST": "0.0.0.0"
  },
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": { "label": "Skyttel API", "onAutoForward": "notify" },
    "5173": {
      "label": "Skyttel web client",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt@26.908.40401"],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postStartCommand"
}
